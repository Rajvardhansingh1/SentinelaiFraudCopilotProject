# LLM providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Proxy
SENTINELAI_HOST=0.0.0.0
SENTINELAI_PORT=8000
RATE_LIMIT_PER_SESSION=8
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Logs DB — local SQLite by default. For a cloud deployment (D-053), point
# this at a Supabase Postgres instance instead, e.g.:
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
# Never commit the real connection string — set it as a platform secret.
DATABASE_URL=sqlite:///./data/logs.db

# Chroma
CHROMA_PERSIST_DIR=./data/chroma

# Auth (Phase 2, D-055) — JWT signing secret. REQUIRED in production
# (ENV=production); the app refuses to start without one. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# App
ENV=development
